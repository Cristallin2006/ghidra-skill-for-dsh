{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/session_start.py\"", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/session_start.py\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Pwsh|pwsh|Bash|bash",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/gate_sample.py\"", "timeout": 10 },
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/gate_longrun.py\"", "timeout": 10 },
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/gate_explore.py\"", "timeout": 15 }
        ]
      },
      {
        "matcher": "Write|write",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/gate_churn.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/stop_check.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
